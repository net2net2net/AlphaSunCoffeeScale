<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：Windows 原生 GUI 子系统，不分配/显示控制台窗口（解决点击弹出 CMD 黑窗） -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>CoffeeScale</AssemblyName>
  </PropertyGroup>

  <!-- 目标运行时：Release 默认 win-x64（保持原有 Windows 单文件体验），
       出 Linux / macOS 包时用 -r 覆盖即可：
         dotnet publish -c Release -r linux-x64   -o dist/linux-x64
         dotnet publish -c Release -r osx-arm64   -o dist/osx-arm64
         dotnet publish -c Release -r osx-x64     -o dist/osx-x64
       Debug 构建不设 RID（本机开发用，跨平台无差异）。 -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- 记录当前目标属于哪类平台，供下方条件使用（避免对空属性调用字符串函数报错） -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <_IsWindowsRid Condition="$(RuntimeIdentifier.StartsWith('win'))">true</_IsWindowsRid>
    <_IsMacRid Condition="$(RuntimeIdentifier.StartsWith('osx'))">true</_IsMacRid>
    <_IsLinuxRid Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('linux-musl'))">true</_IsLinuxRid>
  </PropertyGroup>

  <!-- 发布（Release）默认产出「单个可执行文件」：运行时+托管程序集+原生渲染库
       （SkiaSharp/ANGLE/HarfBuzz/AvaloniaNative）全部内嵌，首次运行自解压到临时目录；
       目标机无需安装 .NET。Debug 构建不受影响（保留 pdb 便于调试）。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 仅 Windows 目标需要 Win32 应用清单与 .ico 图标（ELF / Mach-O 上无意义） -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' Or '$(_IsWindowsRid)' == 'true'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- macOS 目标：Avalonia.Native(Cocoa) 后端，最低 macOS 11 Big Sur -->
  <PropertyGroup Condition="'$(_IsMacRid)' == 'true'">
    <SupportedOSPlatformVersion>11.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 桌面平台实现（Win32/Skia + 经典桌面生命周期）；UI 控件与主题在共享库 CoffeeScale.UI 中。 -->
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共享 UI 库（MainWindow / App / 转换器，四端复用）+ 逻辑层。 -->
    <ProjectReference Include="..\CoffeeScale.UI\CoffeeScale.UI.csproj" />
    <ProjectReference Include="..\CoffeeScale.ViewModels\CoffeeScale.ViewModels.csproj" />
    <ProjectReference Include="..\CoffeeScale.Core\CoffeeScale.Core.csproj" />
  </ItemGroup>

</Project>
