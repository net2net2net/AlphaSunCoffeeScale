<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS 头工程：复用共享 UI 库 CoffeeScale.UI 与逻辑层。
         本环境无法安装 ios workload（证书/MSI 信任问题），此工程需在已装
         `dotnet workload install ios` + Xcode 的 macOS 上构建；此处为完整脚手架。
         真机：  dotnet build -c Release -r ios-arm64
         模拟器：dotnet build -c Debug   -r iossimulator-x64
         RuntimeIdentifier 不写死，构建时用 -r 指定，二者皆可用（见下方 Condition 默认）。 -->
    <TargetFramework>net9.0-ios</TargetFramework>
    <!-- ⚠️ 必须 Exe：macios 仅在 OutputType=Exe 时置 _CanOutputAppBundle=true。
         缺此项时 build/publish 仍会「成功」，但**静默跳过 .app 打包**且无任何报错
         （只打印空的 "Created the package: "），产物目录空空如也 —— 2026-09-24 踩坑记录。 -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 手动配置证书/描述文件（CI 无证书时用 -p:EnableCodeSigning=false 关闭签名） -->
    <ProvisioningType>manual</ProvisioningType>
    <!-- 真机链接模式：只裁剪 SDK、保留程序集元数据，避免反射（Avalonia 绑定）被裁掉 -->
    <MtouchLink>SdkOnly</MtouchLink>
    <!-- 最低 iOS 14.0：与 Info.plist MinimumOSVersion 一致（.NET iOS 以此属性生成该键） -->
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <!-- 默认真机 arm64；传 -r iossimulator-x64 即可切到模拟器，互不冲突 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
    <!-- 开发与 TestFlight/Ad-Hoc 签名的授权文件（get-task-allow 仅在开发/调试为 true） -->
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- 应用图标：目录 Assets.xcassets/AppIcon.appiconset。
         AppIcon 属性必须显式给（= appiconset 目录名），否则 actool 不生成 Assets.car，
         装到真机上是「空白默认图标」——2026-09-25 打包首个 IPA 时踩到（包内无 Assets.car）。
         Link 元数据对齐 macios 默认项定义，保证 xcassets 目录结构在 actool 输入里被还原。 -->
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoffeeScale.UI\CoffeeScale.UI.csproj" />
    <ProjectReference Include="..\CoffeeScale.ViewModels\CoffeeScale.ViewModels.csproj" />
    <ProjectReference Include="..\CoffeeScale.Core\CoffeeScale.Core.csproj" />
  </ItemGroup>

  <!-- App 图标资源目录（Assets.xcassets/AppIcon.appiconset）经 actool 编译为 Assets.car -->
  <ItemGroup>
    <ImageAsset Include="Assets.xcassets/**/*.*" Exclude="$(DefaultItemExcludes)">
      <Link>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '%(FullPath)'))</Link>
      <IsDefaultItem>false</IsDefaultItem>
    </ImageAsset>
  </ItemGroup>

</Project>
